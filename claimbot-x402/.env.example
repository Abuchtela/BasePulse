# Public receiving address designated for ClaimBot USDC payments.
# Override only if you intentionally change the payout wallet.
X402_PAY_TO=0x748f6614Ea6289664bC8BeB84835E2F24fE52482

# Public address of the account that actually publishes verified Arkiv records.
# Public publisher address designated by the owner; not a private key.
# Only records actually created by this address can be sold.
ARKIV_TRUSTED_PUBLISHER=0x4aBAf297bd37bb3FA0036b45976A92a46d903688

# Safe defaults: Base Sepolia TEST USDC payments, $0.10 per valid query.
X402_NETWORK=base-sepolia
X402_PRICE=$0.10

# Mainnet requires explicit operator activation after verifying live settlement.
# X402_NETWORK=base
# ALLOW_MAINNET_X402_SELLER=true
# X402_FACILITATOR_URL=https://YOUR_VERIFIED_MAINNET_FACILITATOR
