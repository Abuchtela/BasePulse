# BasePulse Environment Variables

# Database
DATABASE_URL=mysql://user:password@localhost:3306/basepulse

# Coinbase Developer Platform (CDP) SDK
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# Social Media APIs
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

NEYNAR_API_KEY=

# Analytics
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Base Developer Platform — Registry API
# BASE_API_KEY: Bearer token for authenticated requests to base.org/api/registry
#   Format: bdev_... (get from base.dev > Settings > API Keys)
BASE_API_KEY=

# BASE_BUILDER_CODE: ERC-8021 attribution tag appended to all onchain transactions
#   as a dataSuffix so Base can attribute activity back to BasePulse.
#   Format: bc_... (get from base.dev > Settings > Builder Code)
#   Docs: https://docs.base.org/base-chain/builder-codes/app-developers
BASE_BUILDER_CODE=bc_hi2cipof

# NEAR Intents / 1Click API
# Safe default: disabled and simulation-only. Live deposits require both switches,
# exact asset/recipient allowlists, and an authenticated admin session.
NEAR_INTENTS_ENABLED=false
NEAR_INTENTS_LIVE_EXECUTION=false
ONE_CLICK_JWT=
NEAR_INTENTS_REFERRAL=basepulse
NEAR_INTENTS_MAX_ACTION_USD=10
NEAR_INTENTS_MAX_DAILY_USD=25
NEAR_INTENTS_MAX_SLIPPAGE_BPS=100
NEAR_INTENTS_MIN_TREND_CONFIDENCE=70
NEAR_INTENTS_QUOTE_WAIT_MS=3000
NEAR_INTENTS_ALLOWED_ORIGIN_ASSETS=
NEAR_INTENTS_ALLOWED_DESTINATION_ASSETS=
NEAR_INTENTS_ALLOWED_RECIPIENTS=
