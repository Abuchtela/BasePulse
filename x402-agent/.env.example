# Coinbase Developer Platform credentials
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Optional Base builder attribution
BASE_BUILDER_CODE=bc_hi2cipof

# Target paid endpoint. You can also pass the URL on the command line.
X402_API_URL=https://x402.vercel.app/protected

# Safe defaults
X402_ENVIRONMENT=development
X402_MAX_PER_PAYMENT_USD=0.25
X402_DAILY_BUDGET_USD=5.00

# Mainnet is locked unless BOTH are set deliberately:
# X402_ENVIRONMENT=production
# ALLOW_MAINNET_X402=true
